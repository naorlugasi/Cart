{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"console.log('no build step')\"",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data,src,public}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
